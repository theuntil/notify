# ─────────────────────────────────────────────────────────────
#  ct-notify · Ortam Değişkenleri
#  Bu dosyayı .env olarak kopyalayın (Dokploy'da Environment sekmesi)
# ─────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ── VERİTABANI ───────────────────────────────────────────────
# Supabase'inizle AYNI Postgres. Servis kendi "notify" şemasını kullanır,
# sizin tablolarınıza dokunmaz.
# Aynı Docker ağındaysa: postgresql://postgres:PAROLA@supabase-db:5432/postgres
DATABASE_URL=postgresql://postgres:PAROLA@db:5432/postgres
DB_SCHEMA=notify

# ── GÜVENLİK ─────────────────────────────────────────────────
# Site ile servis arasındaki paylaşılan sır. Next.js'teki NOTIFY_SERVICE_SECRET
# ile BİREBİR AYNI olmalı. Üretmek için:  openssl rand -hex 32
SERVICE_SECRET=

# OTP kodlarını hash'lerken kullanılan gizli tuz. Bir kez belirleyin, DEĞİŞTİRMEYİN
# (değiştirirseniz bekleyen tüm kodlar geçersiz olur).  openssl rand -hex 32
OTP_PEPPER=

# Tarayıcıdan doğrudan erişim yok; boş bırakın. Gerekirse: https://cocuktribunu.org
ALLOWED_ORIGINS=

# ── OTP DAVRANIŞI ────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# ── HIZ SINIRLARI ────────────────────────────────────────────
RATE_PER_TARGET_HOUR=5
RATE_PER_TARGET_DAY=15
RATE_PER_IP_HOUR=20

# ── E-POSTA (turkticaret.net) ────────────────────────────────
SMTP_HOST=smtp.turkticaret.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=iletisim@cocuktribunu.com
SMTP_PASS=
SMTP_FROM_NAME=Çocuk Tribünü
SMTP_FROM_EMAIL=iletisim@cocuktribunu.com

# ── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_ENABLED=true

# verify    → kodu Twilio üretir ve doğrular, numara satın almaya GEREK YOK
# messaging → kodu biz üretiriz, Twilio yalnızca SMS iletir (numara gerekir)
TWILIO_MODE=verify

TWILIO_ACCOUNT_SID=ACe190bfe10be6692e877f18a85273bfd2
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VA40915fdcb1e02f6be4b0b7f31ff0a949
# Yalnızca TWILIO_MODE=messaging için
TWILIO_FROM_NUMBER=

# ── SİTE ─────────────────────────────────────────────────────
SITE_URL=https://cocuktribunu.org
SITE_NAME=Çocuk Tribünü
SUPPORT_EMAIL=iletisim@cocuktribunu.com

# ── Zamanlanmış görevler ────────────────────────────────────
# Kart süre uyarıları ve dolum bildirimleri günde bir kez gönderilir.
# Kapatmak için false yapın; servis normal çalışmaya devam eder.
SCHEDULER_ENABLED=true
# Günün saati (0-23, sunucu saatiyle)
SCHEDULER_HOUR=9
# Kaç gün kala uyarı gönderilsin
EXPIRY_WARNING_DAYS=7
